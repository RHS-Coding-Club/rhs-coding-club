{
  "name": "rhs-coding-club",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf:types": "wrangler types",
    "og:render": "bun scripts/og-image/render.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply rhs-coding-club --local",
    "db:migrate:prod": "wrangler d1 migrations apply rhs-coding-club --remote",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:prod": "bun scripts/seed.ts --remote",
    "db:restore": "bun scripts/restore-backup.ts",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "bunx @better-auth/cli@latest generate --config src/lib/auth.ts --output src/db/schema/auth.generated.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.17",
    "@better-auth/drizzle-adapter": "^1.7.17",
    "@better-auth/mcp": "^1.7.17",
    "@better-auth/oauth-provider": "^1.7.17",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/server": "^2.4.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/static-renderer": "^3.32.2",
    "better-auth": "^1.7.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.1.3",
    "motion": "^13.5.1",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "uqr": "^0.1.3",
    "vgpu": "^0.6.0",
    "worker-mailer": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/eslint-config": "latest",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "@modelcontextprotocol/server": "^2.4.0",
    "fast-uri": "^3.1.9",
    "ip-address": "^10.7.5",
    "seroval": "^1.7.5",
    "seroval-plugins": "^1.7.5",
    "source-map-js": "^1.2.2",
    "systeminformation": "^5.33.16",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  }
}
