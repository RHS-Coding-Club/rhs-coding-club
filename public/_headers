# Read by Workers static assets; not served. Vite names everything under
# /assets/ by content hash, so a changed file gets a new URL and the old one
# can be cached for good. Without this, every page view revalidates each
# script, stylesheet, and font (the default is max-age=0, must-revalidate).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
